---
// The shell every page shares: <head> with SEO tags, header, footer and cookie banner.
import '../styles/tokens.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { site } from '../data/site';
import { path, withoutBase } from '../utils/paths';

import interFont from '../assets/fonts/inter-latin.woff2?url';
import soraFont from '../assets/fonts/sora-latin.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Image for social sharing: a path starting with / or a full address. */
  image?: string;
  /** Ask search engines not to list this page (used for the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = path(site.shareImage),
  noindex = false,
} = Astro.props;

// The address search engines should treat as the real one: always on the main domain.
const pagePath = withoutBase(Astro.url.pathname).replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = new URL(pagePath, site.url).href;
const imageUrl = new URL(image, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={path('/favicon.png')} />
    <link rel="apple-touch-icon" href={path('/apple-touch-icon.png')} />
    <link rel="sitemap" href={path('/sitemap-index.xml')} />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={soraFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
